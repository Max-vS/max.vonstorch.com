# Locally, the URLs of the Neon `dev` branch of personal-db; in Vercel, the Neon integration sets them.
# Pooled Neon URL (host has `-pooler`); the app reads it at runtime.
DATABASE_URL=
# Direct Neon URL (no `-pooler`); migrations use it, as Neon recommends.
DATABASE_URL_UNPOOLED=

# At least 32 random characters, a different value per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production and development only, where the Music page's Spotify token read needs it; previews take their URL from the request host.
BETTER_AUTH_URL=http://127.0.0.1:3000

# The owner's verified GitHub email; every other GitHub account is rejected.
OWNER_EMAIL=

# A GitHub OAuth app allows one callback URL, so production (https://max.vonstorch.com/api/auth/callback/github) and local development (http://127.0.0.1:3000/api/auth/callback/github) each need their own app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A Spotify app whose owner has Premium, with the redirect URIs https://max.vonstorch.com/api/auth/callback/spotify and http://127.0.0.1:3000/api/auth/callback/spotify; its tokens expire 6 months after linking, then Reconnect on /admin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Key for the daily visitor IP hash: openssl rand -base64 32
IP_HASH_SECRET=
