# Local PGlite (`bun run db:local`) uses postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable for both database URLs.

# Pooled Neon URL (host has `-pooler`); the app reads it at runtime.
DATABASE_URL=
# Direct Neon URL (no `-pooler`); migrations use it, as Neon recommends.
DATABASE_URL_UNPOOLED=

# At least 32 random characters, a different value per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production and development only; previews take their URL from the request host.
BETTER_AUTH_URL=http://127.0.0.1:3000

# The only email that can have an account.
OWNER_EMAIL=
# Read only by `bun run seed:owner`; never store it in Vercel.
OWNER_PASSWORD=

# Key for the daily visitor IP hash: openssl rand -base64 32
IP_HASH_SECRET=
